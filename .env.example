APP_NAME=karakorum-analytica
APP_DISPLAY_NAME=Karakorum Analytica
APP_ENV=development
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=sqlite:///./local.db

# CORS — comma-separated browser origins (include your Render dashboard URL in production)
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501,http://localhost:5173,http://127.0.0.1:5173

# Supabase (recommended for production / shared deploys)
# Get these from: https://supabase.com/dashboard → Project Settings
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=
# Option A — paste full Postgres connection string (recommended):
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Option A2 — IPv4 pooler for Render (Dashboard → Connect → Session pooler, port 5432):
# SUPABASE_DB_POOLER_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Or set region only (auto-builds pooler URL from SUPABASE_DB_URL on Render):
# SUPABASE_POOLER_REGION=ap-south-1
# Use the JWT service_role key from Project Settings → API (starts with eyJ...), not sb_secret_*
# Option B — build URL from project URL + database password:
# SUPABASE_DB_PASSWORD=

# SpiderFoot OSINT (auto-cloned at build; web UI on port 5001)
SPIDERFOOT_ENABLED=true
SPIDERFOOT_AUTOSTART=true
SPIDERFOOT_BASE_URL=http://127.0.0.1:5001
SPIDERFOOT_DATA=data/spiderfoot
SPIDERFOOT_DEFAULT_USECASE=passive

# Comma-separated proxies for open news RSS/HTML fetching (http://user:pass@host:port)
PROXY_URLS=
SCRAPER_USE_CURL_CFFI=false
SCRAPER_RESPECT_ROBOTS=true
SCRAPER_REQUEST_DELAY_SECONDS=1.5
SCRAPER_MAX_RETRIES=3
# Public RSS feeds — Name|URL (open news channels, not X/social login)
# NEWS_CHANNEL_FEEDS=Dawn|https://www.dawn.com/feeds/home,Geo|https://www.geo.tv/latest/rss/1
NEWS_CHANNEL_FEEDS=

COLLECTION_INTERVAL_MINUTES=15
SCHEDULER_ENABLED=true
RUN_COLLECTION_ON_STARTUP=true

RELIEFWEB_APPNAME=

ACLED_EMAIL=
ACLED_API_KEY=

# Scweet (X search — https://github.com/Altimis/Scweet)
SCWEET_ENABLED=true
SCWEET_USERNAME=kkanalytica
SCWEET_PASSWORD=Hello123Bye456Hi987
SCWEET_EMAIL=
SCWEET_AUTH_TOKEN=
SCWEET_AUTO_LOGIN=true
SCWEET_LOGIN_HEADLESS=false
SCWEET_SESSION_CACHE_PATH=data/scweet_session.json
SCWEET_COOKIES_FILE=
SCWEET_DB_PATH=data/scweet_state.db
# SCWEET_SEARCH_QUERIES=(Pakistan OR Balochistan) (attack OR blast) lang:en
SCWEET_LIMIT=50
SCWEET_SINCE_DAYS=7
SCWEET_PROXY=
SCWEET_LANG=en

# Render API — local sync script only (https://dashboard.render.com/u/settings#api-keys)
RENDER_API_KEY=
# Single Render web service ID (srv-...)
RENDER_SERVICE_ID=
# Or comma-separated IDs for API + dashboard:
# RENDER_SERVICE_IDS=srv-xxxxxxxxxxxxxxxxxxxx,srv-yyyyyyyyyyyyyyyyyyyy
# Legacy fallbacks (optional):
RENDER_SCWEET_SERVICE_NAMES=karakorum-analytica-api,karakorum-analytica-dashboard
# RENDER_SCWEET_SERVICE_IDS=srv-xxxxxxxxxxxxxxxxxxxx,srv-yyyyyyyyyyyyyyyyyyyy

X_POSTING_ENABLED=false
# X (Twitter) API v2 — https://developer.x.com/en/portal/dashboard
# Create a Project + App with Read and Write permissions, then generate:
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
# Optional read-only app token (search/public lookup — cannot post tweets):
X_BEARER_TOKEN=

# LLM newsroom dashboard (optional — uses template inference when unset)
LLM_PROVIDER=placeholder
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
LLM_DASHBOARD_PATH=llm-dashboard/dist
