# Karakorum Analytica — Streamlit dashboard (local / Render)
# Copy to repo root as .env for local dev, or set in Render → karakorum-analytica-dashboard → Environment

# FastAPI backend URL (Render sets this automatically via Blueprint fromService)
API_BASE_URL=http://127.0.0.1:8000

# Scweet / X (required for embedded mode Scweet tab on Render)
SCWEET_ENABLED=true
SCWEET_USERNAME=kkanalytica
SCWEET_PASSWORD=Hello123Bye456Hi987
SCWEET_EMAIL=
SCWEET_AUTO_LOGIN=true
SCWEET_LOGIN_HEADLESS=false
SCWEET_SESSION_CACHE_PATH=data/scweet_session.json
SCWEET_DB_PATH=data/scweet_state.db

# Optional collector credentials (also supported via Streamlit secrets on Streamlit Cloud)
# ACLED_EMAIL=
# ACLED_API_KEY=
# RELIEFWEB_APPNAME=
