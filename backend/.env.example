# Karakorum Analytica — API backend environment variables
# Backend code lives at repo root in app/ (not a separate backend/ folder).
# Copy this file to the repo root as .env for local development.

APP_NAME=karakorum-analytica
APP_DISPLAY_NAME=Karakorum Analytica
APP_ENV=development
ENVIRONMENT=development
DEBUG=true

DATABASE_URL=sqlite:///./local.db

# CORS — comma-separated browser origins allowed to call the API
ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# Supabase (recommended for production on Render)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET_NAME=
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# SUPABASE_DB_PASSWORD=

# Optional third-party integrations
SCRAPER_API_KEY=

COLLECTION_INTERVAL_MINUTES=15
SCHEDULER_ENABLED=true
RUN_COLLECTION_ON_STARTUP=false

RELIEFWEB_APPNAME=
ACLED_EMAIL=
ACLED_API_KEY=

X_POSTING_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_BEARER_TOKEN=

# Scweet (X search)
SCWEET_ENABLED=true
SCWEET_USERNAME=kkanalytica
SCWEET_PASSWORD=Hello123Bye456Hi987
SCWEET_EMAIL=
SCWEET_AUTO_LOGIN=true
SCWEET_LOGIN_HEADLESS=false
SCWEET_SESSION_CACHE_PATH=data/scweet_session.json
SCWEET_DB_PATH=data/scweet_state.db
SCWEET_LIMIT=50
SCWEET_SINCE_DAYS=7
SCWEET_LANG=en
